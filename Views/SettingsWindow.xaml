<Window x:Class="DesktopWeather.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки погоды на рабочем столе"
        Width="580" Height="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#0D0D0D"
        Foreground="#ECECEC"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Custom Dark ScrollBar with clearly visible thumb -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="Foreground" Value="#707070"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumbBorder"
                                                        Background="{TemplateBinding Foreground}"
                                                        BorderBrush="#999999"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#AAAAAA"/>
                                                        <Setter TargetName="thumbBorder" Property="BorderBrush" Value="#FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Bar Window Controls Button Styles -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C40E1E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Language Toggle Button Style -->
        <Style x:Key="LangToggleStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="7,3" Margin="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#282828"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#000000"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style (Monochrome Dark) -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="#252525"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Weather Button Style (Monochrome High Contrast) -->
        <Style x:Key="WeatherBtnStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="BorderBrush" Value="#2C2C2C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="8,7"
                                Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#282828"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4C4C4C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#000000"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Radio Button Style -->
        <Style x:Key="MiniRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="8,5"
                                Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#000000"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Slider Thumb with High Contrast -->
        <Style x:Key="ModernSliderThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="20" Height="20">
                            <Ellipse x:Name="outerRing" Fill="#FFFFFF" Stroke="#000000" StrokeThickness="2.5">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.55" Direction="270"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="innerDot" Width="6" Height="6" Fill="#000000"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outerRing" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="outerRing" Property="Stroke" Value="#333333"/>
                                <Setter TargetName="outerRing" Property="StrokeThickness" Value="3"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="outerRing" Property="Fill" Value="#E0E0E0"/>
                                <Setter TargetName="innerDot" Property="Fill" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RepeatButtons for Slider Track -->
        <Style x:Key="SliderTrackButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Sleek Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,7"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Background Track -->
                            <Border Height="6" Background="#262626" CornerRadius="3" BorderBrush="#383838" BorderThickness="1"/>
                            <!-- Track with Filled portion and Thumb -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackButton}" Command="{x:Static Slider.DecreaseLarge}">
                                        <Border Height="6" Background="#666666" CornerRadius="3,0,0,3" Margin="1,0,0,0"/>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernSliderThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackButton}" Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E2E2"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="checkBorder" Width="18" Height="18"
                                    Background="#1C1C1C" BorderBrush="#3A3A3A" BorderThickness="1"
                                    CornerRadius="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path x:Name="checkMark" Data="M 3,8 L 7,12 L 14,4"
                                      Stroke="#000000" StrokeThickness="2" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox ToggleButton Style -->
        <Style x:Key="ModernComboBoxToggle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="templateRoot"
                                Background="#1C1C1C"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Border Width="24" HorizontalAlignment="Right">
                                <Path x:Name="arrow" Data="M 0,0 L 4,4 L 8,0"
                                      Stroke="#AAAAAA" StrokeThickness="1.6"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#666666"/>
                                <Setter TargetName="arrow" Property="Stroke" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#888888"/>
                                <Setter TargetName="arrow" Property="Stroke" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style (Dark Popup, readable text) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="#E2E2E2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="3,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#000000"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full Custom ComboBox Style (guaranteed dark popup, completely fixes white background blending) -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot">
                            <ToggleButton x:Name="toggleButton"
                                          Style="{StaticResource ModernComboBoxToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="contentPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   Focusable="False">
                                <Border x:Name="dropDownBorder"
                                        Background="#181818"
                                        BorderBrush="#383838"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}"
                                        MaxHeight="450"
                                        Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.6" Direction="270"/>
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#0D0D0D">
        <Grid.RowDefinitions>
            <!-- 1. Custom Dark Title Bar -->
            <RowDefinition Height="38"/>
            <!-- 2. Main Scrollable Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Dark Window Title Bar (Monochrome frame, no white border) -->
        <Border Grid.Row="0" Background="#111111" BorderBrush="#222222" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <!-- Window Controls & Language Switcher (Right) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Language Switcher (RU / EN) -->
                    <Border Background="#1C1C1C" BorderBrush="#353535" BorderThickness="1" CornerRadius="5" Padding="2" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="BtnLangRu" Content="RU" Style="{StaticResource LangToggleStyle}" Checked="OnLanguageChanged"/>
                            <RadioButton x:Name="BtnLangEn" Content="EN" Style="{StaticResource LangToggleStyle}" Checked="OnLanguageChanged"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="─" Click="OnTitleBarMinimizeClick" ToolTip="Свернуть"/>
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}" Content="✕" Click="OnTitleBarCloseClick" ToolTip="Свернуть в трей"/>
                </StackPanel>

                <!-- App Icon & Title (Left) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Width="18" Height="18" CornerRadius="4" Background="#1C1C1C" BorderBrush="#353535" BorderThickness="1" Margin="0,0,8,0">
                        <Viewbox Width="12" Height="12">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#FFFFFF" Data="M19.35,10.04 C18.67,6.59 15.64,4 12,4 C9.11,4 6.6,5.64 5.35,8.04 C2.34,8.36 0,10.91 0,14 C0,17.31 2.69,20 6,20 L19,20 C21.76,20 24,17.76 24,15 C24,12.36 21.95,10.22 19.35,10.04 Z"/>
                                <Path Fill="#1C1C1C" Data="M12.5,8 L8.5,13.5 L11.5,13.5 L10,18.5 L15.5,12.5 L12.5,12.5 Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock x:Name="TxtTitleBar" Text="Настройки погоды на рабочем столе" FontSize="12" Foreground="#D0D0D0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,14,18,16">

                <!-- Header (High Contrast Icon & Text) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                    <Border Width="40" Height="40" CornerRadius="8" Background="#1C1C1C" BorderBrush="#383838" BorderThickness="1" Margin="0,0,12,0">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#FFFFFF" Data="M19.35,10.04 C18.67,6.59 15.64,4 12,4 C9.11,4 6.6,5.64 5.35,8.04 C2.34,8.36 0,10.91 0,14 C0,17.31 2.69,20 6,20 L19,20 C21.76,20 24,17.76 24,15 C24,12.36 21.95,10.22 19.35,10.04 Z"/>
                                <Path Fill="#1C1C1C" Data="M12.5,8 L8.5,13.5 L11.5,13.5 L10,18.5 L15.5,12.5 L12.5,12.5 Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeaderTitle" Text="ПОГОДА НА РАБОЧЕМ СТОЛЕ" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <Border Background="#1C1C1C" BorderBrush="#353535" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0" FontSize="10.5" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtHeaderSubtitle" Text="Живые атмосферные эффекты и цветовая среда рабочего стола" FontSize="11" Foreground="#888888"/>
                    </StackPanel>
                </StackPanel>

                <!-- 1. Выбор погоды (7 режимов без солнца) -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock x:Name="TxtWeatherSection" Text="ВЫБОР ПОГОДЫ" FontSize="11" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,8"/>
                        <UniformGrid Columns="5">
                            <RadioButton x:Name="BtnSnow" Style="{StaticResource WeatherBtnStyle}" Checked="OnWeatherChecked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="❄️" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSnow" Text="Снег" FontWeight="Medium" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="BtnRain" Style="{StaticResource WeatherBtnStyle}" Checked="OnWeatherChecked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🌧️" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtRain" Text="Дождь" FontWeight="Medium" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="BtnStorm" Style="{StaticResource WeatherBtnStyle}" Checked="OnWeatherChecked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtStorm" Text="Гроза" FontWeight="Medium" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="BtnSakura" Style="{StaticResource WeatherBtnStyle}" Checked="OnWeatherChecked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🌸" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSakura" Text="Сакура" FontWeight="Medium" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="BtnLeaves" Style="{StaticResource WeatherBtnStyle}" Checked="OnWeatherChecked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🍁" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtLeaves" Text="Листопад" FontWeight="Medium" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="BtnFireflies" Style="{StaticResource WeatherBtnStyle}" Checked="OnWeatherChecked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="✨" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtFireflies" Text="Светлячки" FontWeight="Medium" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="BtnMist" Style="{StaticResource WeatherBtnStyle}" Checked="OnWeatherChecked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="☁️" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtMist" Text="Туман" FontWeight="Medium" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="BtnFire" Style="{StaticResource WeatherBtnStyle}" Checked="OnWeatherChecked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🔥" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtFire" Text="Огонь" FontWeight="Medium" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="BtnWaterDrops" Style="{StaticResource WeatherBtnStyle}" Checked="OnWeatherChecked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="💧" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtWaterDrops" Text="Капли" FontWeight="Medium" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="BtnWind" Style="{StaticResource WeatherBtnStyle}" Checked="OnWeatherChecked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="💨" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtWind" Text="Ветер" FontWeight="Medium" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 2. Специфичные настройки погодных режимов -->
                <!-- Опции снега -->
                <Border x:Name="CardSnowStyle" Style="{StaticResource CardPanel}">
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="TxtSnowStyleLabel" Text="Форма снега:" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <RadioButton x:Name="BtnSnowBoth" Content="❄️⚪ Смешанный" Style="{StaticResource MiniRadioStyle}" Checked="OnSnowStyleChanged"/>
                            <RadioButton x:Name="BtnSnowCrystals" Content="❄️ Снежинки" Style="{StaticResource MiniRadioStyle}" Checked="OnSnowStyleChanged"/>
                            <RadioButton x:Name="BtnSnowFlakes" Content="⚪ Шарики" Style="{StaticResource MiniRadioStyle}" Checked="OnSnowStyleChanged"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Опции грозы (без дождя) -->
                <Border x:Name="CardStormStyle" Style="{StaticResource CardPanel}">
                    <CheckBox x:Name="ChkStormClouds" Content="⚡ Показывать грозовые тучи вверху экрана"
                              Checked="OnStormCloudsChanged" Unchecked="OnStormCloudsChanged"/>
                </Border>

                <!-- 3. Цветовой фильтр экрана -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock x:Name="TxtColorSection" Text="ЦВЕТОВАЯ АТМОСФЕРА ЭКРАНА" FontSize="11" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,8"/>
                        <DockPanel LastChildFill="True" Margin="0,0,0,8">
                            <TextBlock x:Name="TxtColorFilterLabel" Text="Фильтр экрана:" Foreground="#CCCCCC" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CmbColorFilter" SelectionChanged="OnColorFilterChanged" MaxDropDownHeight="450">
                                <ComboBoxItem x:Name="CmbItemOff" Content="🚫 Отключить (без фильтра)" Tag="Off"/>
                                <ComboBoxItem x:Name="CmbItemAuto" Content="🔄 Авто (по текущей погоде)" Tag="Auto" IsSelected="True"/>
                                <ComboBoxItem x:Name="CmbItemSnow" Content="❄️ Зимний холодный (синий)" Tag="Snow"/>
                                <ComboBoxItem x:Name="CmbItemRain" Content="🌧️ Дождевой (пасмурный)" Tag="Rain"/>
                                <ComboBoxItem x:Name="CmbItemStorm" Content="⚡ Грозовой (тёмно-штормовой)" Tag="Storm"/>
                                <ComboBoxItem x:Name="CmbItemSakura" Content="🌸 Весенний (нежный розовый)" Tag="Sakura"/>
                                <ComboBoxItem x:Name="CmbItemLeaves" Content="🍁 Осенний (тёплый янтарь)" Tag="Leaves"/>
                                <ComboBoxItem x:Name="CmbItemFireflies" Content="✨ Ночной (глубокий индиго)" Tag="Fireflies"/>
                                <ComboBoxItem x:Name="CmbItemMist" Content="☁️ Туманный (дымчатый)" Tag="Mist"/>
                                <ComboBoxItem x:Name="CmbItemFire" Content="🔥 Огненный (тёплый янтарно-красный)" Tag="Fire"/>
                                <ComboBoxItem x:Name="CmbItemWaterDrops" Content="💧 Аквамарин (стеклянно-водный)" Tag="WaterDrops"/>
                                <ComboBoxItem x:Name="CmbItemWind" Content="💨 Ветреный (прохладный лазурный)" Tag="Wind"/>
                            </ComboBox>
                        </DockPanel>

                        <DockPanel LastChildFill="False">
                            <TextBlock x:Name="TxtFilterIntensityLabel" Text="Интенсивность оттенка:" Foreground="#888888" FontSize="12"/>
                            <TextBlock x:Name="LblFilterIntensity" Text="8%" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Slider x:Name="SliderFilterIntensity" Minimum="0.0" Maximum="0.25" Value="0.08"
                                TickFrequency="0.01" IsSnapToTickEnabled="True"
                                ValueChanged="OnFilterIntensityChanged"/>
                    </StackPanel>
                </Border>

                <!-- 4. Параметры частиц -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock x:Name="TxtParticlesSection" Text="ПАРАМЕТРЫ ЧАСТИЦ И ВЕТРА" FontSize="11" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,8"/>

                        <!-- Плотность -->
                        <DockPanel LastChildFill="False">
                            <TextBlock x:Name="TxtCountLabel" Text="Количество частиц:" Foreground="#CCCCCC" FontSize="12"/>
                            <TextBlock x:Name="LblCount" Text="140" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Slider x:Name="SliderCount" Minimum="0" Maximum="500" Value="140"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="OnCountChanged"/>

                        <!-- Скорость -->
                        <DockPanel LastChildFill="False">
                            <TextBlock x:Name="TxtSpeedLabel" Text="Скорость:" Foreground="#CCCCCC" FontSize="12"/>
                            <TextBlock x:Name="LblSpeed" Text="1.0x" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Slider x:Name="SliderSpeed" Minimum="0.2" Maximum="3.0" Value="1.0"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                ValueChanged="OnSpeedChanged"/>

                        <!-- Ветер -->
                        <DockPanel LastChildFill="False">
                            <TextBlock x:Name="TxtWindLabel" Text="Ветер:" Foreground="#CCCCCC" FontSize="12"/>
                            <TextBlock x:Name="LblWind" Text="Штиль (0.0)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Slider x:Name="SliderWind" Minimum="-3.0" Maximum="3.0" Value="0.0"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                ValueChanged="OnWindChanged"/>

                        <!-- Размер -->
                        <DockPanel LastChildFill="False">
                            <TextBlock x:Name="TxtScaleLabel" Text="Размер элементов:" Foreground="#CCCCCC" FontSize="12"/>
                            <TextBlock x:Name="LblScale" Text="1.0x" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Slider x:Name="SliderScale" Minimum="0.4" Maximum="2.5" Value="1.0"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                ValueChanged="OnScaleChanged"/>

                        <!-- Прозрачность -->
                        <DockPanel LastChildFill="False">
                            <TextBlock x:Name="TxtOpacityLabel" Text="Яркость / Прозрачность:" Foreground="#CCCCCC" FontSize="12"/>
                            <TextBlock x:Name="LblOpacity" Text="85%" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Slider x:Name="SliderOpacity" Minimum="0.1" Maximum="1.0" Value="0.85"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="OnOpacityChanged"/>
                    </StackPanel>
                </Border>

                <!-- 5. Звук и FPS -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <!-- Звук -->
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <CheckBox x:Name="ChkSound" Content="🔊 Звуковые эффекты (гром, метель, дождь)"
                                      Checked="OnSoundToggled" Unchecked="OnSoundToggled"/>
                            <TextBlock x:Name="LblVolume" Text="18%" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Slider x:Name="SliderVolume" Minimum="0.0" Maximum="1.0" Value="0.18"
                                TickFrequency="0.01" SmallChange="0.01" LargeChange="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="OnVolumeChanged"/>

                        <!-- FPS -->
                        <DockPanel LastChildFill="False" Margin="0,6,0,2">
                            <TextBlock x:Name="TxtFpsLabel" Text="Частота кадров (FPS):" Foreground="#CCCCCC" FontSize="12"/>
                            <TextBlock x:Name="LblFps" Text="60 FPS (Стандарт)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Slider x:Name="SliderFps" Minimum="0" Maximum="4" Value="1"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="OnFpsChanged"/>
                    </StackPanel>
                </Border>

                <!-- 6. Быстрые опции -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <CheckBox x:Name="ChkClickThrough" Content="🖱️ Прокликивание сквозь экран (клики идут по окнам и рабочему столу)"
                                  Checked="OnClickThroughChanged" Unchecked="OnClickThroughChanged"/>
                        <CheckBox x:Name="ChkAutostart" Content="🚀 Запускать автоматически при входе в Windows"
                                  Checked="OnAutostartChanged" Unchecked="OnAutostartChanged"/>
                        <Button x:Name="BtnCreateShortcut" Content="📌 Создать ярлык на рабочем столе"
                                Background="#1E1E1E" Foreground="#CCCCCC" BorderBrush="#333333" BorderThickness="1"
                                Padding="12,6" Margin="0,10,0,0" HorizontalAlignment="Left" Cursor="Hand" Click="OnCreateShortcutClick">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Кнопки управления (Monochrome) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,8">
                    <Button x:Name="BtnReset" Content="🔄 Сброс"
                            Background="#1E1E1E" Foreground="#CCCCCC" BorderBrush="#333333" BorderThickness="1"
                            Padding="14,7" Margin="0,0,10,0" Cursor="Hand" Click="OnResetClick">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="BtnPause" Content="⏸️ Приостановить"
                            Background="#1E1E1E" Foreground="#CCCCCC" BorderBrush="#333333" BorderThickness="1"
                            Padding="14,7" Margin="0,0,10,0" Cursor="Hand" Click="OnPauseClick">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="BtnMinimize" Content="⬇️ Свернуть в трей"
                            Background="#FFFFFF" Foreground="#000000" BorderBrush="#FFFFFF" BorderThickness="1"
                            Padding="16,7" Cursor="Hand" FontWeight="SemiBold" Click="OnMinimizeToTrayClick">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Footer with Author & Website -->
                <Border Margin="0,10,0,4" Padding="0,10,0,0" BorderBrush="#222222" BorderThickness="0,1,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtAuthor" Text="Автор: " FontSize="12" Foreground="#777777"/>
                            <TextBlock Text="NeonicFlow" FontSize="12" FontWeight="SemiBold" Foreground="#ECECEC"/>
                            <TextBlock Text="   •   " FontSize="12" Foreground="#444444"/>
                            <TextBlock FontSize="12" Cursor="Hand">
                                <Hyperlink NavigateUri="https://neonicflow.ru" RequestNavigate="OnHyperlinkRequestNavigate"
                                           Foreground="#FFFFFF" TextDecorations="{x:Null}">
                                    neonicflow.ru
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text="   •   " FontSize="12" Foreground="#444444"/>
                            <TextBlock Text="v1.0" FontSize="12" Foreground="#888888"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTrayTip" Text="💡 Значок приложения в системном трее возле часов. Правый клик — быстрое меню."
                                   FontSize="11" Foreground="#555555" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
